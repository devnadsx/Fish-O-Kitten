    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 1
    deslocamentoX: 5
    deslocamentoY: 0
    duracaoMovimento: 1.5
  - nomeQuemFala: Paxton
    texto: "H\xE3? Como assim?"
