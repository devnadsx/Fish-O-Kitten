    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: Foi bem divertido, na verdade.
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "N\xE3o sei se usaria essa palavra."
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "Ah, Paxton, voc\xEA precisa aprender a se divertir um pouco!"
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "Estou me divertindo. Olha como que eu t\xF4 feliz."
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: Hahahah. Claro que sim!
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "Enfim, muito obrigada aos dois por participarem. Foi um prazer conversar
      com voc\xEAs!"
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: Obrigado pelo convite, Saky!
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "Obrigado tamb\xE9m.."
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: E, Myke...
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: Sim..?
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "Boa sorte com esse a\xED."
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: Vou precisar!
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "Eu t\xF4 bem aqui, sabia?"
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "Todos, junto da plateia, riem. A plateia aplaude eles, e as cortinas
      come\xE7am a se fechar."
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "At\xE9 a pr\xF3xima, \xE9 s\xE9rio! Foi muito divertido hoje!"
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: Ela se despede dos dois, que ficam ali, antes de sairem juntos. Eles voltam
      pra casa do Myke, sem falar nada.
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  velocidadeEscrita: 0.07
  audioSourceFala: {fileID: 1031518405}
  somFalaPadrao: {fileID: 0}
