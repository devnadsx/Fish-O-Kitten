--- !u!114 &684543766
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 684543765}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c2ef4e293a228ba429dac075a5a3b84a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EntrevistaPaxtonManager
  painelBalaoFala: {fileID: 536729366}
  textoNomePersonagem: {fileID: 1355338277}
  textoBalao: {fileID: 2132858260}
  imagemMyke: {fileID: 1436648940}
  imagemPaxton: {fileID: 2016071866}
  imagemSaky: {fileID: 48322229}
  myke:
    nome: Myke
    expressoes:
    - nomeExpressao: Normal
      bocaFechada: {fileID: -2774935278654895130, guid: ac555857b32beef449adc9a054559984, type: 3}
      bocaAberta: {fileID: -7421273427394222630, guid: 3054c74687683bd4fa2fec20613a26a7, type: 3}
  paxton:
    nome: Paxton
    expressoes:
    - nomeExpressao: Normal
      bocaFechada: {fileID: 2327593037766731116, guid: cd2fa6c8d6942024a8445f9d98cde8af, type: 3}
      bocaAberta: {fileID: -6760148359141997971, guid: d08bff1fa3e3ce74999a157a1f75c422, type: 3}
  saky:
    nome: Saky
    expressoes:
    - nomeExpressao: Normal
      bocaFechada: {fileID: -1768769924907106779, guid: b6c4e47d19c91c34891c4d478515d380, type: 3}
      bocaAberta: {fileID: 3376071792619935919, guid: 6cf82002ea8e6d6469cecbaf89f46190, type: 3}
  falas:
  - nomeQuemFala: Narrador
    texto: "As c\xE2meras est\xE3o ligadas, os convidados est\xE3o acomodados e nossa
      apresentadora est\xE1 pronta. O que poderia dar errado?"
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: Bem... considerando os convidados de hoje, talvez bastante coisa.
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "Ol\xE1, ol\xE1! Sejam muito bem-vindos a mais uma entrevista!"
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: E hoje temos dois convidados bastante... interessantes.
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: "Interessantes? Isso \xE9 bom ou ruim?"
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "Depende do que voc\xEAs v\xE3o me contar hoje!"
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Paxton
    texto: "J\xE1 estou come\xE7ando a me arrepender de ter aceitado."
    ehNarracao: 0
    posicao: 1
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: "Ah, para Pax! Nem come\xE7amos ainda."
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "Hahahahah! Bom, para quem ainda n\xE3o conhece voc\xEAs, poderiam se
      apresentar?"
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: "Claro! Eu sou o Myke. Trabalho com pesquisa e an\xE1lise, e... bem, acho
      que \xE9 isso."
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Paxton
    texto: "Paxton. N\xE3o tenho muito mais a acrescentar."
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "Nossa, que apresenta\xE7\xF5es... empolgantes. Vou precisar fazer o trabalho
      por voc\xEAs."
    ehNarracao: 0
    posicao: 1
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: "A culpa \xE9 dele, me desculpa!"
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Paxton
    texto: Ah! Cala a boca, Myke!
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: A plateia ri. Paxton sorri enquanto Myke revira os olhos com um sorrisinho
      no rosto.
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "Certo! Vamos come\xE7ar com algo um pouco mais interessante. Voc\xEAs
      passaram por algumas situa\xE7\xF5es bastante complicadas juntos, n\xE3o \xE9?"
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: "\xC9... acho que essa \xE9 uma maneira de colocar as coisas."
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Paxton
    texto: Uma maneira bastante gentil, inclusive.
    ehNarracao: 0
    posicao: 1
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "E como voc\xEAs se sentem em rela\xE7\xE3o a tudo isso agora?"
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: "N\xE3o vou dizer que foi f\xE1cil. Aconteceram coisas que eu realmente
      n\xE3o gostaria de repetir."
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Paxton
    texto: E algumas delas foram culpa minha.
    ehNarracao: 0
    posicao: 1
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: Algumas?
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Paxton
    texto: "T\xE1 bom, foram muitas."
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "Pelo menos temos algu\xE9m reconhecendo os pr\xF3prios erros!"
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 1
    deslocamentoX: -5
    deslocamentoY: 0
    duracaoMovimento: 1
  - nomeQuemFala: Paxton
    texto: "N\xE3o precisa parecer t\xE3o surpresa."
    ehNarracao: 0
    posicao: 1
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: "Myke p\xF5e a m\xE3o na boca tentando segurar a risada."
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "Mas, falando s\xE9rio, voc\xEAs conseguiram superar essas diferen\xE7as?"
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: Superar talvez seja uma palavra forte. Acho que estamos aprendendo a conviver
      com o que aconteceu.
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Paxton
    texto: ' E tentando fazer diferente daqui pra frente.'
    ehNarracao: 0
    posicao: 1
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: "\xC9. Isso tamb\xE9m."
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "Apesar de tudo o que aconteceu, os dois ainda se zoam e riem como amigos.
      Isso \xE9 t\xE3o fofo, mas ser\xE1 que realmente \xE9 assim?"
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "E como \xE9 trabalhar juntos depois de tudo isso?"
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: "Ah, \xE9... interessante."
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Paxton
    texto: Ele quer dizer que sou um excelente colega de trabalho.
    ehNarracao: 0
    posicao: 1
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Myke
    texto: "Eu definitivamente n\xE3o disse isso."
    ehNarracao: 0
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
