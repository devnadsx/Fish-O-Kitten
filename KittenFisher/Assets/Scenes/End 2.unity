    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "Voc\xEA parece prestar bastante aten\xE7\xE3o no Myke. Mais do que costuma
      demonstrar."
    ehNarracao: 0
    posicao: 2
    somFala: {fileID: 8300000, guid: 0c17a25fb54e6934791de0c94bf4450c, type: 3}
