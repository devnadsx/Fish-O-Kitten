    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "Ent\xE3o vou perguntar diretamente: voc\xEA gosta dele?"
    ehNarracao: 0
    posicao: 2
