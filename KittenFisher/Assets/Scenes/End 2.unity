    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "A plateia ri. Paxton sorri satisfeito, claramente confort\xE1vel com
      a aten\xE7\xE3o. Por enquanto, parece acreditar que pode transformar qualquer
      pergunta em uma piada."
    ehNarracao: 1
    posicao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Narrador
    texto: "A plateia ri. Paxton sorri satisfeito, claramente confort\xE1vel com
