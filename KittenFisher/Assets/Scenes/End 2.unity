    expressaoSaky: Normal
    moverPaxton: 1
    deslocamentoX: -10
    deslocamentoY: 0
    duracaoMovimento: 1
  - nomeQuemFala: Narrador
    texto: "E agora chegamos \xE0 parte que todos estavam esperando... ou pelo menos
      \xE0 parte que algu\xE9m aqui claramente n\xE3o gostaria de responder."
