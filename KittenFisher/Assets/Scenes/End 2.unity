    expressaoMyke: Normal
    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "\xC9 literalmente meu trabalho!"
