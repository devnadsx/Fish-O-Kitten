    expressaoPaxton: Normal
    expressaoSaky: Normal
    moverPaxton: 0
    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Saky
    texto: "\xC9 s\xF3 uma observa\xE7\xE3o. Voc\xEA sempre parece acompanhar o que
      ele est\xE1 fazendo, presta aten\xE7\xE3o quando ele fala e at\xE9 muda um
      pouco o jeito de agir quando ele est\xE1 por perto."
