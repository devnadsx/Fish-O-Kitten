    deslocamentoX: 0
    deslocamentoY: 0
    duracaoMovimento: 0
  - nomeQuemFala: Paxton
    texto: "Imagino que n\xE3o v\xE1 adiantar dizer n\xE3o."
    ehNarracao: 0
    posicao: 1
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
