    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: Arruinar a minha carreira completamente.
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: "Sem contar em como voc\xEA s\xF3 se intrometeu na minha vida e atrapalhou
      o meu projeto..."
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: E ainda ousa vir dizer que me ama...?
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: "Myke se levanta, e cruzo os bra\xE7os, franzindo a testa."
    ehNarracao: 1
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: -10
    deslocamentoYMyke: 15
    duracaoMovimentoMyke: 2
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: "'Ce acha que eu sou o qu\xEA, Paxton? Idiota!? Eu jamais amaria voc\xEA!"
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Paxton
    texto: "Paxton engole em seco, desviando o olhar pro lado. Ele come\xE7a a tremer,
      hesitando em falar, tremendo o l\xE1bio."
    ehNarracao: 1
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: "O que foi!? O gato comeu sua l\xEDngua?"
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Paxton
    texto: M-Myke... E-eu...
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Paxton
    texto: "Myke come\xE7a a rir meio descontrolado agora"
    ehNarracao: 1
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: "Agora 'ce fica assim, se vitimizando todo, sendo que quem que sofreu
      mais nessa hist\xF3ria. Foi eu!"
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: "Se voc\xEA realmente me amasse, nada disso teria acontecido!"
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Paxton
    texto: M-Mas...
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: Cala a boca!
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 4982b1de7fd8a214187d79feb0439aac, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: Myke muda bruscamente o tom de voz, olhar com aquele olhar de quando bateu
      nele.
    ehNarracao: 1
    somFala: {fileID: 8300000, guid: 3cc2f7f0224b35f44a9d36b946c2d7da, type: 3}
    expressaoMyke: N
    expressaoPaxton: Ds
    moverMyke: 0
    deslocamentoXMyke: 0
    deslocamentoYMyke: 0
    duracaoMovimentoMyke: 0
    moverPaxton: 0
    deslocamentoXPaxton: 0
    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 0
  - nomeQuemFala: Myke
    texto: "Paxton... Eu quero que voc\xEA saia, agora. Da minha casa..."
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 4982b1de7fd8a214187d79feb0439aac, type: 3}
