    deslocamentoYPaxton: 0
    duracaoMovimentoPaxton: 6
  - nomeQuemFala: Myke
    texto: "Depois de tudo que voc\xEA fez..."
    ehNarracao: 0
    somFala: {fileID: 8300000, guid: 01e71ceb9b67c924cb514d5d7286791d, type: 3}
